<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Modify Post</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

  <div class="container mt-5" style="max-width: 600px;">
    <div class="card shadow">
      <div class="card-header bg-dark text-white">
        <h4 class="mb-0">Edit Post #<%= post.id %></h4>
      </div>
      <div class="card-body">
        <form action="/update-post/<%= post.id %>" method="POST">
          <div class="mb-3">
            <label class="form-label">Author Name</label>
            <input type="text" name="authorName" value="<%= post.author %>" class="form-control" required>
          </div>

          <div class="mb-3">
            <label class="form-label">Post Title</label>
            <input type="text" name="postTitle" value="<%= post.title %>" class="form-control" required>
          </div>

          <div class="mb-3">
            <label class="form-label">Topic Category</label>
            <select name="postCategory" class="form-select">
              <% categories.forEach(cat => { %>
                <option value="<%= cat %>" <%= post.category === cat ? 'selected' : '' %>><%= cat %></option>
              <% }); %>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label">Content</label>
            <textarea name="postContent" class="form-control" rows="5" required><%= post.content %></textarea>
          </div>

          <div class="d-flex justify-content-end gap-2">
            <a href="/" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-success">Update Entry</button>
          </div>
        </form>
      </div>
    </div>
  </div>

</body>
</html>